# Ключ Anthropic API для LLM-извлечения структуры процесса (ФТ-3).
# Если не задан — сервер работает на детерминированном офлайн-экстракторе
# (без передачи данных во внешние сервисы, см. НФТ-4).
ANTHROPIC_API_KEY=

# Модель для извлечения структуры (temperature=0, см. НФТ-3).
LLM_MODEL=claude-sonnet-4-5
